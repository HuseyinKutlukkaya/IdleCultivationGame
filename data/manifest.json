{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "meta": {
    "comment": "Registers every JSON definition collection loaded by the DataManager. Adding a new content type = drop JSON files under data/ and add one entry here. No code changes required."
  },
  "collections": [
    {
      "id": "realms",
      "files": ["data/realms/realms.json"],
      "validation": {
        "requiredFields": [
          "id",
          "name",
          "description",
          "tier",
          "qiMaxMultiplier",
          "cultivationSpeedMultiplier",
          "lifespanYears",
          "powerMultiplier",
          "unlocks"
        ],
        "uniqueField": "id"
      }
    },
    {
      "id": "items",
      "files": ["data/items/items.json"],
      "validation": { "requiredFields": ["id", "name", "stackSize"], "uniqueField": "id" }
    },
    {
      "id": "upgrades",
      "files": ["data/upgrades/upgrades.json"],
      "validation": {
        "requiredFields": ["id", "name", "category", "costResource", "baseCost", "costGrowth", "effectPerLevel"],
        "uniqueField": "id"
      }
    },
    {
      "id": "breakthroughs",
      "files": ["data/breakthroughs/breakthroughs.json"],
      "validation": {
        "requiredFields": ["realmId", "requiredProgress", "cost", "bottleneck", "results"],
        "uniqueField": "realmId"
      }
    },
    {
      "id": "tribulations",
      "files": ["data/tribulations/tribulations.json"],
      "validation": {
        "requiredFields": ["realmId", "tribulationType", "results"],
        "uniqueField": "realmId"
      }
    },
    {
      "id": "spirit-roots",
      "files": ["data/spirit-roots/spirit-roots.json"],
      "validation": {
        "requiredFields": ["id", "name", "tier", "elements", "attributes", "speedMultiplier", "weight"],
        "uniqueField": "id"
      }
    },
    {
      "id": "techniques",
      "files": ["data/techniques/techniques.json"],
      "validation": {
        "requiredFields": ["id", "name", "baseCost", "costMultiplier", "baseRevenue", "revenuePerLevel", "cooldownMs"],
        "uniqueField": "id"
      }
    },
    {
      "id": "meridians",
      "files": ["data/meridians/meridians.json"],
      "validation": {
        "requiredFields": ["id", "name", "capacityMultiplier", "flowMultiplier"],
        "uniqueField": "id"
      }
    },
    {
      "id": "physiques",
      "files": ["data/physiques/physiques.json"],
      "validation": {
        "requiredFields": ["id", "name", "breakthroughBonus", "lifespanMultiplier", "healthMultiplier", "powerMultiplier"],
        "uniqueField": "id"
      }
    },
    {
      "id": "dantian",
      "files": ["data/dantian/dantian.json"],
      "validation": {
        "requiredFields": ["id", "name", "capacityMultiplier", "densityMultiplier", "purityMultiplier", "efficiencyMultiplier"],
        "uniqueField": "id"
      }
    }
  ]
}
